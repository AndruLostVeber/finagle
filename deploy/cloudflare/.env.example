# Copy to .env in this directory for local Wrangler development.
# Keep real authorization keys in .env locally and in Cloudflare secrets remotely.
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-3-Ultra
# Enable only on a development server. Preview never changes the real ranking.
KURO_TEST_MODE=false
